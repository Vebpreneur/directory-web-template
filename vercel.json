{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "docusaurus-2",
      "buildCommand": "DOCS_BASE_URL=/docs/ pnpm build"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
